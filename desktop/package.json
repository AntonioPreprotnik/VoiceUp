{
  "name": "voiceup",
  "version": "0.0.0",
  "private": true,
  "description": "Speak commands to an interactive Claude Code session",
  "author": "Antonio Preprotnik",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --excludePackages \"argparse@2.0.1;sax@1.6.1\" --onlyAllow \"MIT;Apache-2.0;BSD;BSD-2-Clause;BSD-3-Clause;ISC\"",
    "bench:speech": "node test/audio/bench.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "5.0.0",
    "eslint": "10.14.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.12",
    "node-pty": "1.2.0-beta.18",
    "sherpa-onnx-node": "2.0.1",
    "tar-stream": "3.2.2",
    "unbzip2-stream": "1.4.3",
    "zod": "4.6.7"
  }
}
